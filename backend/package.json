{
  "name": "convoo-backend",
  "version": "1.0.0",
  "description": "Backend for Convoo AI Mock Interviewer",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node -r dotenv/config dist/server.js",
    "dev": "nodemon --watch \"services/**/*.ts\" --watch \"routes/**/*.ts\" --watch \"server.ts\" --exec \"node -r dotenv/config -r ts-node/register server.ts\""
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.1",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "interview",
    "ai",
    "whisper",
    "openai"
  ],
  "author": "Convoo Team",
  "license": "MIT"
}

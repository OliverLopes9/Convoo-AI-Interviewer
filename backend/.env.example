# Server
PORT=5001
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/convoo

# JWT secret — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=

# Deepgram speech-to-text (https://deepgram.com)
DEEPGRAM_API_KEY=

# Google Gemini (optional, not currently used directly)
GEMINI_API_KEY=

# OpenRouter AI — interview questions & evaluation (https://openrouter.ai)
OPENROUTER_API_KEY=

# D-ID talking avatar (optional)
DID_API_KEY=
# DID_SOURCE_URL=

# Frontend origin for CORS in production
# FRONTEND_ORIGIN=https://your-frontend-domain.com
